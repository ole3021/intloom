{
  "name": "@intloom/cli",
  "version": "0.5.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ole3021/intloom.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/ole3021/intloom",
  "bugs": {
    "url": "https://github.com/ole3021/intloom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "@intloom/compiler": "workspace:*",
    "@intloom/kernel": "workspace:*",
    "@intloom/loom-sdk": "workspace:*"
  },
  "bin": {
    "intloom": "./dist/bin.js"
  },
  "exports": {
    "./bin": "./dist/bin.js"
  }
}
