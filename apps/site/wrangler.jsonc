{
  "name": "intloom-site",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/releases", "/download/*"]
  },
  "main": "worker.mjs"
}
