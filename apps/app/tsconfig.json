{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "paths": {
      "@/*": ["./src/view/*"],
      "electrobun": ["./.sdk/bun/ElectrobunConfig.d.ts"],
      "electrobun/bun": ["./src/main/sdk.d.ts"],
      "electrobun/view": ["./.sdk/browser/index.d.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "electrobun.config.ts",
    "node_modules/electrobun/dist/api/browser/global.d.ts"
  ]
}
