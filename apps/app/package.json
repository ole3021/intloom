{
  "name": "intloom-desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && electrobun dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.electrobun.json && tsc --noEmit",
    "desktop:build": "bun run build && electrobun build --env=dev",
    "desktop:release": "bun run build && node scripts/build-installer.mjs"
  },
  "dependencies": {
    "electrobun": "1.18.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "tailwindcss": "4.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "vite": "8.3.5"
  }
}
