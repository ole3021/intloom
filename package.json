{
  "name": "intloom",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check": "biome check . && turbo run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "verify": "bun run check && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
