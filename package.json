{
  "name": "intloom",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=26.4.0",
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:dev": "bun run build --filter=@intloom/cli... && node scripts/install-dev-cli.ts",
    "pack": "turbo run pack",
    "typecheck": "turbo run typecheck",
    "check": "biome check . && turbo run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "node scripts/test-scripts.ts && turbo run test",
    "test:intg": "turbo run test:intg",
    "test:package": "turbo run test:package",
    "test:artifacts": "node scripts/test-package-artifacts.ts --clean",
    "verify": "bun run check && bun run test && bun run test:intg && bun run test:package && node scripts/release-manifest.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@dotenvx/dotenvx": "2.24.1",
    "@types/node": "^26",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  }
}
