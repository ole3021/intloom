import { defineCode, defineLoom, withDefault } from "@intloom/loom-sdk";
import { z } from "zod";
export default defineLoom({ id: "simple", version: "1.0.0", description: "Simple capability", entry: defineCode({ id: "code", inputSchema: z.strictObject({ count: withDefault(z.number().int().min(1), 3), label: z.string().optional() }), outputSchema: z.strictObject({ count: z.number() }), execute: () => { throw new Error("BUSINESS_EXECUTED"); } }) });
