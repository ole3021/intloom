{
  "name": "@intloom/loom-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Public contracts and stateless capabilities for compiled IntLoom Looms",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiled": {
      "types": "./dist/compiled.d.ts",
      "default": "./dist/compiled.js"
    },
    "./definition": {
      "types": "./dist/capability.d.ts",
      "default": "./dist/capability.js"
    },
    "./loom.schema.json": "./schemas/loom.schema.json",
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./app-contracts": {
      "types": "./dist/app-contracts.d.ts",
      "default": "./dist/app-contracts.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schemas"
  ],
  "dependencies": {
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.spec.ts\"",
    "pack": "node ../../scripts/pack-package.ts .",
    "test:package": "node --test \"test/package/*.intg.ts\""
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ole3021/intloom.git",
    "directory": "packages/loom-sdk"
  },
  "homepage": "https://github.com/ole3021/intloom",
  "bugs": {
    "url": "https://github.com/ole3021/intloom/issues"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/core": {
      "optional": true
    }
  }
}
