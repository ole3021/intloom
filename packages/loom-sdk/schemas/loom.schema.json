{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": "1",
      "type": "string",
      "const": "1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "input": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "output": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "execute": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["code"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "required": ["agent"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["workflow"],
          "additionalProperties": false
        }
      ]
    },
    "agents": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "resume": {
            "type": "string",
            "minLength": 1
          },
          "modelProfile": {
            "type": "string",
            "enum": ["light", "standard", "deep"]
          },
          "input": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          },
          "output": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          },
          "interactions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "skills": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tools": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["definition", "modelProfile"],
        "additionalProperties": false
      }
    },
    "apps": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "default": "index.html",
            "type": "string",
            "minLength": 1
          },
          "type": {
            "default": "html",
            "type": "string",
            "const": "html"
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "required": ["app"],
          "additionalProperties": false
        }
      },
      "required": ["result"],
      "additionalProperties": false
    },
    "interactions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "form"
              },
              "app": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "validate": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "context": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                ]
              },
              "response": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                ]
              }
            },
            "required": ["kind", "title", "context", "response"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "select"
              },
              "app": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "presentation": {
                "type": "object",
                "properties": {
                  "choices": {
                    "type": "object",
                    "properties": {
                      "itemsPath": {
                        "type": "string",
                        "pattern": "^(?:\\/(?:[^~]|~[01])*)*$"
                      },
                      "valuePath": {
                        "type": "string",
                        "pattern": "^(?:\\/(?:[^~]|~[01])*)*$"
                      },
                      "labelPath": {
                        "type": "string",
                        "pattern": "^(?:\\/(?:[^~]|~[01])*)*$"
                      },
                      "responsePath": {
                        "type": "string",
                        "pattern": "^(?:\\/(?:[^~]|~[01])*)*$"
                      }
                    },
                    "required": [
                      "itemsPath",
                      "valuePath",
                      "labelPath",
                      "responsePath"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": ["choices"],
                "additionalProperties": false
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "validate": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "context": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                ]
              },
              "response": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                ]
              }
            },
            "required": ["kind", "title", "context", "response"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "confirm"
              },
              "app": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "validate": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "context": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/__schema0"
                    }
                  }
                ]
              }
            },
            "required": ["kind", "title", "context"],
            "additionalProperties": false
          }
        ]
      }
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "checks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "description": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["id", "code"],
            "additionalProperties": false
          }
        },
        "confirmation": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["name", "version", "input", "output", "execute"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
