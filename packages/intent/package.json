{
  "name": "@intloom/intent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/loom.generated.d.ts",
      "default": "./dist/loom.generated.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@intloom/kernel": "workspace:*",
    "@intloom/cli": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "@intloom/utils": "workspace:*",
    "@intloom/loom-sdk": "workspace:*"
  },
  "scripts": {
    "dev": "node --test --watch \"stages/**/*.spec.ts\" \"src/**/*.spec.ts\"",
    "build": "intloom build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"stages/**/*.spec.ts\" \"src/**/*.spec.ts\" \"e2e/checks/*.spec.mjs\"",
    "test:intg": "node --test \"test/*.intg.ts\"",
    "pack": "node ../../scripts/pack-package.ts dist",
    "test:package": "node --test \"test/package/*.intg.ts\""
  },
  "loom": {
    "type": "loom",
    "version": "2026-10-15",
    "name": "intent",
    "inputs": [
      "prompt"
    ],
    "exclusive": true,
    "entry": "specification",
    "stages": {
      "specification": {
        "stage": "./stages/specification/stage.yaml",
        "on": {
          "complete": {
            "target": "solution"
          }
        }
      },
      "solution": {
        "stage": "./stages/solution/stage.yaml",
        "on": {
          "complete": {
            "target": "implementation"
          }
        }
      },
      "implementation": {
        "stage": "./stages/implementation/stage.yaml",
        "on": {
          "complete": {
            "target": "validation"
          }
        }
      },
      "validation": {
        "stage": "./stages/validation/stage.yaml",
        "on": {
          "complete": {
            "end": true
          }
        }
      }
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ole3021/intloom.git",
    "directory": "packages/intent"
  },
  "homepage": "https://github.com/ole3021/intloom",
  "bugs": {
    "url": "https://github.com/ole3021/intloom/issues"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
