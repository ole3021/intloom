{
  "name": "@intloom/kernel",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    },
    "./storage/file": {
      "types": "./dist/storage/file/open.d.ts",
      "default": "./dist/storage/file/open.js"
    },
    "./storage/sqlite": {
      "types": "./dist/storage/sqlite/open.d.ts",
      "default": "./dist/storage/sqlite/open.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "migrations",
    "LICENSE"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.103",
    "@ai-sdk/provider": "3.0.14",
    "@mastra/core": "1.67.0",
    "@intloom/utils": "workspace:*",
    "zod": "^4.6.5",
    "yaml": "^2.8.1",
    "drizzle-orm": "0.45.3",
    "better-sqlite3": "13.0.3",
    "@intloom/workflow-sdk": "workspace:*"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.spec.ts\"",
    "test:intg": "node --test \"test/**/*.intg.ts\"",
    "storage:generate": "drizzle-kit generate --config=drizzle.config.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ole3021/intloom.git",
    "directory": "packages/kernel"
  },
  "homepage": "https://github.com/ole3021/intloom",
  "bugs": {
    "url": "https://github.com/ole3021/intloom/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
