{
  "name": "@intloom/compiler",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --test --watch \"src/**/*.spec.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test:intg": "node --test \"test/*.intg.ts\"",
    "test": "node --test \"src/**/*.spec.ts\"",
    "pack": "node ../../scripts/pack-package.ts .",
    "test:package": "node --test \"test/package/*.intg.ts\""
  },
  "dependencies": {
    "@intloom/loom-sdk": "workspace:*",
    "@intloom/utils": "workspace:*",
    "acorn": "^8.15.0",
    "parse5": "7.3.0",
    "typescript": "7.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.6.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ole3021/intloom.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/ole3021/intloom",
  "bugs": {
    "url": "https://github.com/ole3021/intloom/issues"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Build compiled IntLoom Loom packages"
}
