{
  "name": "@intloom/compiler",
  "version": "0.4.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ole3021/intloom.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/ole3021/intloom",
  "bugs": {
    "url": "https://github.com/ole3021/intloom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "@intloom/loom-sdk": "workspace:*",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "tar": "7.5.22",
    "semver": "7.8.6",
    "zod": "4.6.7",
    "yaml": "2.9.1",
    "@babel/parser": "7.29.9"
  },
  "devDependencies": {
    "@babel/types": "7.29.8"
  },
  "bin": {
    "intloom-build": "./dist/bin.js"
  }
}
